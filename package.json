{
  "name": "mellow-cf",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "test": "vitest run",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "format": "prettier --write .",
    "deploy": "bun run deploy:production",
    "deploy:production": "node scripts/release-production.mjs",
    "deploy:production:check": "node scripts/release-production.mjs --check",
    "build:dev": "CLOUDFLARE_ENV=dev bun run build",
    "deploy:dev": "bun run build:dev && wrangler deploy",
    "preview": "bun run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply mellow-db --local",
    "db:migrate:dev": "wrangler d1 migrations apply mellowart-dev-db --config wrangler.jsonc --env dev --remote",
    "db:migrations:production": "wrangler d1 migrations list mellow-db --config wrangler.jsonc --remote",
    "db:migrate:production": "wrangler d1 migrations apply mellow-db --config wrangler.jsonc --remote",
    "db:seed:local": "wrangler d1 execute mellow-db --local --file=seed.sql",
    "db:query:local": "wrangler d1 execute mellow-db --local --command",
    "db:admin:local": "wrangler d1 execute mellow-db --local --command \"$(bun run scripts/create-admin.ts ${ADMIN_EMAIL:-admin@example.com} ${ADMIN_PASSWORD:-password})\"",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && bun run db:migrate:local && bun run db:seed:local && bun run db:admin:local"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.36",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.78.0",
    "react-router": "^7.10.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.1",
    "@cloudflare/vitest-pool-workers": "^0.16.14",
    "@react-router/dev": "^7.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  }
}
